{
  "extends": "@habit/tsconfig/nextjs.json",
  "compilerOptions": {
    // Stays here: the Next language-service plugin resolves from this project.
    "plugins": [{ "name": "next" }],
    // Stays here: relative to THIS file.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

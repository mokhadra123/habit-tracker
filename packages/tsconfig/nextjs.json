{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Habit Tracker — Next.js app",
  "extends": "./base.json",

  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],

    "module": "esnext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true
  }
}
